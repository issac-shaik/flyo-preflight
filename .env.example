# Copy to .env and adjust. Never commit .env.

# --- Flyo API (defaults point at the bundled mock) ---
FLYO_BASE_URL=http://127.0.0.1:4010
FLYO_API_KEY=flyo_test_demo_key
# Secret Flyo sends back in the webhook auth_header ("Authorization: Bearer <secret>")
FLYO_WEBHOOK_SECRET=change-me-webhook-secret
# Public URL of this app as Flyo can reach it (used as callbackUrl)
APP_PUBLIC_URL=http://127.0.0.1:3000

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=3000
POLL_INTERVAL_MS=15000

# --- Mock Flyo ---
MOCK_HOST=127.0.0.1
MOCK_PORT=4010
MOCK_FLYO_API_KEY=flyo_test_demo_key
MOCK_QUOTA_UNITS=50
# 1 = pretend the airline check-in window is already open so the demo completes in seconds
MOCK_FAST_FORWARD=1
# 1 = deliver the final webhook twice to exercise event_id de-duplication
MOCK_DUPLICATE_FINAL_WEBHOOK=1

# --- Optional: vision LLM for real ticket PDFs and passport photos ---
# LLM_PROVIDER=gemini | openai | anthropic
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override; defaults are set per provider in src/app/extract/llm.mjs
LLM_MODEL=

# --- Optional: real WhatsApp via Twilio sandbox (default: in-browser phone simulator) ---
MESSAGING=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
